{
  "name": "review-room",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "tsx scripts/test-integration.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:check": "tsx scripts/check-database.ts",
    "db:local:start": "node scripts/local-database.mjs start",
    "db:local:stop": "node scripts/local-database.mjs stop",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "supabase:check": "tsx scripts/check-supabase.ts",
    "uploads:cleanup": "tsx scripts/cleanup-uploads.ts",
    "demo:cleanup": "tsx scripts/cleanup-demo.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "db:rehearse": "tsx scripts/rehearse-migrations.ts",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.58.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "server-only": "0.0.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "class-variance-authority": "0.7.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "prisma": "7.10.1",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "dotenv": "18.0.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
