generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum WorkspaceRole {
  OWNER
  DESIGNER
  CLIENT

  @@schema("app")
}

model UserProfile {
  // Equals a verified Supabase Auth user ID after Step 2.
  // Local seed identities are fixtures and cannot sign in.
  id                  String                @id @db.Uuid
  displayName         String                @db.VarChar(100)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  memberships         Membership[]
  assetVersions       AssetVersion[]
  comments            Comment[]
  reviewDecisions     ReviewDecision[]
  activityReads       ProjectActivityRead[]
  reviewerDemoAccount ReviewerDemoAccount?
  ownedWorkspace      Workspace?            @relation("WorkspaceCreator")
  requiredReviews     ReviewRoundReviewer[]

  @@schema("app")
}

model Workspace {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(100)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  memberships          Membership[]
  projects             Project[]
  createdById          String?               @unique @db.Uuid
  reviewerDemoAccounts ReviewerDemoAccount[]
  creator              UserProfile?          @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@schema("app")
}

model Membership {
  workspaceId String          @db.Uuid
  userId      String          @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        UserProfile     @relation(fields: [userId], references: [id], onDelete: Restrict)
  projects    ProjectMember[]

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])
  @@schema("app")
}

model Project {
  id               String                @id @default(uuid()) @db.Uuid
  workspaceId      String                @db.Uuid
  name             String                @db.VarChar(150)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  completionId     String?               @unique @db.Uuid
  description      String?               @db.VarChar(2000)
  dueDate          DateTime?             @db.Date
  archivedAt       DateTime?             @db.Timestamptz(3)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  assets           Asset[]
  invitations      ProjectInvitation[]
  activity         ActivityEvent[]
  activityReads    ProjectActivityRead[]
  reviewRounds     ReviewRound[]
  completions      ProjectCompletion[]   @relation("CompletionHistory")
  activeCompletion ProjectCompletion?    @relation("ActiveCompletion", fields: [completionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reopenings       ProjectReopening[]

  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt, createdAt, id])
  @@schema("app")
}

model ProjectMember {
  projectId   String     @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  project     Project    @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership  Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([workspaceId, userId, projectId])
  @@schema("app")
}

model SignupRateBucket {
  keyHash   String   @id @db.Char(64)
  attempts  Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@schema("app")
}

model SignupPermit {
  tokenHash String   @id @db.Char(64)
  emailHash String   @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@schema("app")
}

enum AssetVersionStatus {
  PENDING
  READY
  FAILED

  @@schema("app")
}

model Asset {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  workspaceId      String         @db.Uuid
  title            String         @db.VarChar(150)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  currentVersionId String?        @unique @db.Uuid
  project          Project        @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  versions         AssetVersion[] @relation("AssetVersions")
  currentVersion   AssetVersion?  @relation("CurrentVersion", fields: [currentVersionId, id], references: [id, assetId], onDelete: NoAction, onUpdate: NoAction)
  reviewRounds     ReviewRound[]

  @@unique([id, projectId, workspaceId])
  @@unique([currentVersionId, id])
  @@index([projectId, workspaceId, createdAt, id])
  @@schema("app")
}

model AssetVersion {
  id               String             @id @default(uuid()) @db.Uuid
  assetId          String             @db.Uuid
  projectId        String             @db.Uuid
  workspaceId      String             @db.Uuid
  versionNumber    Int                @default(1)
  status           AssetVersionStatus @default(PENDING)
  creatorName      String             @default("") @db.VarChar(100)
  creatorId        String             @db.Uuid
  originalName     String             @db.VarChar(255)
  expectedMimeType String             @db.VarChar(30)
  expectedSize     Int
  mimeType         String?            @db.VarChar(30)
  fileSize         Int?
  width            Int?
  height           Int?
  contentHash      String?            @db.Char(64)
  stagingKey       String             @unique
  objectKey        String             @unique
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime           @db.Timestamptz(3)
  cleanupAfter     DateTime           @db.Timestamptz(3)
  cleanupToken     String?            @db.Uuid
  cleanupUntil     DateTime?          @db.Timestamptz(3)
  cleanupRetryAt   DateTime?          @db.Timestamptz(3)
  cleanedAt        DateTime?          @db.Timestamptz(3)
  processingToken  String?            @db.Uuid
  processingUntil  DateTime?          @db.Timestamptz(3)
  failureReason    String?            @db.VarChar(200)
  asset            Asset              @relation("AssetVersions", fields: [assetId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Cascade)
  currentFor       Asset?             @relation("CurrentVersion")
  comments         Comment[]
  reviewDecisions  ReviewDecision[]
  shares           ShareLink[]
  creator          UserProfile        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  reviewRounds     ReviewRound[]

  @@unique([id, assetId])
  @@unique([assetId, versionNumber])
  @@index([workspaceId, projectId, status, createdAt])
  @@index([cleanupAfter, cleanedAt])
  @@schema("app")
}

model Comment {
  id           String       @id @db.Uuid
  versionId    String       @db.Uuid
  authorId     String       @db.Uuid
  authorName   String       @default("") @db.VarChar(100)
  parentId     String?      @db.Uuid
  body         String       @db.VarChar(2000)
  xRatio       Float?       @db.DoublePrecision
  yRatio       Float?       @db.DoublePrecision
  threadNumber Int?
  resolvedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  version      AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author       UserProfile  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent       Comment?     @relation("CommentReplies", fields: [parentId, versionId], references: [id, versionId], onDelete: Cascade, onUpdate: NoAction)
  replies      Comment[]    @relation("CommentReplies")

  @@unique([id, versionId])
  @@unique([versionId, threadNumber])
  @@index([versionId, parentId, createdAt, id])
  @@schema("app")
}

enum ReviewDecisionKind {
  APPROVED
  CHANGES_REQUESTED

  @@schema("app")
}

model ReviewDecision {
  id             String             @id @db.Uuid
  versionId      String             @db.Uuid
  reviewerId     String             @db.Uuid
  decisionNumber Int                @default(0)
  reviewerName   String             @default("") @db.VarChar(100)
  decision       ReviewDecisionKind
  note           String?            @db.VarChar(2000)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  version        AssetVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer       UserProfile        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([versionId, decisionNumber])
  @@index([versionId, createdAt, id])
  @@index([versionId, reviewerId, createdAt, id])
  @@schema("app")
}

model ProjectInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  workspaceId  String        @db.Uuid
  email        String        @db.VarChar(254)
  role         WorkspaceRole
  tokenHash    String        @unique @db.Char(64)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime      @db.Timestamptz(3)
  acceptedAt   DateTime?     @db.Timestamptz(3)
  acceptedById String?       @db.Uuid
  revokedAt    DateTime?     @db.Timestamptz(3)
  project      Project       @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([projectId, createdAt, id])
  @@schema("app")
}

model ShareLink {
  id        String       @id @default(uuid()) @db.Uuid
  versionId String       @db.Uuid
  tokenHash String       @unique @db.Char(64)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt DateTime     @db.Timestamptz(3)
  revokedAt DateTime?    @db.Timestamptz(3)
  version   AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt, id])
  @@schema("app")
}

model CapabilityRateBucket {
  keyHash   String   @id @db.Char(64)
  attempts  Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@schema("app")
}

enum ActivityKind {
  UPLOAD_READY
  COMMENT_CREATED
  REPLY_CREATED
  THREAD_RESOLVED
  THREAD_REOPENED
  REVIEW_APPROVED
  CHANGES_REQUESTED
  INVITE_ACCEPTED

  @@schema("app")
}

model ActivityEvent {
  id            BigInt       @id @default(autoincrement())
  projectId     String       @db.Uuid
  workspaceId   String       @db.Uuid
  sourceKey     String       @unique
  kind          ActivityKind
  actorId       String?      @db.Uuid
  actorName     String       @db.VarChar(100)
  assetId       String?      @db.Uuid
  versionId     String?      @db.Uuid
  versionNumber Int?
  threadNumber  Int?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  project       Project      @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([projectId, workspaceId, id])
  @@schema("app")
}

model ProjectActivityRead {
  projectId       String      @db.Uuid
  workspaceId     String      @db.Uuid
  userId          String      @db.Uuid
  lastReadEventId BigInt      @default(0)
  lastReadAt      DateTime    @db.Timestamptz(3)
  project         Project     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([workspaceId, userId])
  @@schema("app")
}

model DemoSession {
  id           String   @id @db.Uuid
  tokenHash    String   @unique @db.Char(64)
  marker       String   @default("REVIEW_ROOM_DEMO_V1") @db.VarChar(32)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  view         String   @default("DESIGNER") @db.VarChar(8)
  state        Json
  receipts     Json     @default("{}")
  commentCount Int      @default(0)
  actionCount  Int      @default(0)
  generation   Int      @default(0)

  @@index([marker, expiresAt])
  @@schema("app")
}

// Account registry only; authorization roles remain in Membership.
model ReviewerDemoAccount {
  userId            String      @id @db.Uuid
  workspaceId       String      @db.Uuid
  legacyWorkspaceId String?     @db.Uuid
  allowAuthChanges  Boolean     @default(false)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  user              UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@schema("app")
}

model ReviewerDemoQuota {
  userId    String   @id @db.Uuid
  day       DateTime @db.Timestamptz(3)
  mutations Int      @default(0)
  uploads   Int      @default(0)

  @@schema("app")
}

// Server-recorded mailbox proof; no request/browser grants.
model EmailVerificationProof {
  userId     String   @id @db.Uuid
  emailHash  String   @db.Char(64)
  verifiedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@schema("app")
}

model RecoveryGrant {
  tokenHash String   @id @db.Char(64)
  userId    String   @db.Uuid
  sessionId String
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@schema("app")
}

model ReviewRound {
  id              String                @id @db.Uuid
  workspaceId     String                @db.Uuid
  projectId       String                @db.Uuid
  assetId         String                @db.Uuid
  versionId       String                @db.Uuid
  requestedById   String                @db.Uuid
  requestedByName String                @db.VarChar(100)
  reason          String                @db.VarChar(500)
  createdAt       DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  asset           Asset                 @relation(fields: [assetId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  version         AssetVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  project         Project               @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  reviewers       ReviewRoundReviewer[]

  @@index([versionId, createdAt])
  @@schema("app")
}

model ReviewRoundReviewer {
  roundId      String      @db.Uuid
  userId       String      @db.Uuid
  reviewerName String      @db.VarChar(100)
  round        ReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([roundId, userId])
  @@schema("app")
}

model ProjectCompletion {
  id              String            @id @db.Uuid
  workspaceId     String            @db.Uuid
  projectId       String            @db.Uuid
  completedById   String            @db.Uuid
  completedByName String            @db.VarChar(100)
  createdAt       DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  manifest        Json
  project         Project           @relation("CompletionHistory", fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  currentProject  Project?          @relation("ActiveCompletion")
  reopening       ProjectReopening?

  @@schema("app")
}

model ProjectReopening {
  id           String            @id @db.Uuid
  completionId String            @unique @db.Uuid
  projectId    String            @db.Uuid
  actorId      String            @db.Uuid
  actorName    String            @db.VarChar(100)
  reason       String            @db.VarChar(500)
  createdAt    DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completion   ProjectCompletion @relation(fields: [completionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("app")
}

model NotificationJob {
  id            String    @id @db.Uuid
  dedupeKey     String    @unique
  workspaceId   String    @db.Uuid
  projectId     String    @db.Uuid
  kind          String    @db.VarChar(20)
  recipientId   String?   @db.Uuid
  sourceId      String    @db.Uuid
  payload       String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken    String?   @db.Uuid
  leaseUntil    DateTime? @db.Timestamptz(3)
  sentAt        DateTime? @db.Timestamptz(3)
  cancelledAt   DateTime? @db.Timestamptz(3)
  lastCode      String?   @db.VarChar(40)

  @@index([nextAttemptAt])
  @@schema("app")
}

model NotificationPreference {
  userId       String  @id @db.Uuid
  emailEnabled Boolean @default(true)

  @@schema("app")
}
