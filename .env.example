# Copy to .env. These local URLs target ONLY the dedicated db:local:start cluster.
# Runtime may use a Supabase pooled URL later; CLI migrations use a direct/session URL.
DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
DIRECT_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
TEST_DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_test?schema=app"

# Use a separate Supabase development project for hosted local development.
# Keep placeholders empty until configured. Never use production credentials here.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="review-room-private"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate a private random value (at least 32 characters) for HMAC IP hashing.
# Keep it stable across Vercel instances; do not prefix it with NEXT_PUBLIC_.
SIGNUP_RATE_LIMIT_SECRET=""

# Production Vercel only: set NEXT_PUBLIC_APP_URL=https://rreviewroom.vercel.app
# Keep local development at localhost. Never share Production secrets with Preview.
# The project pwzwrknnzkdagfcjnqkr now serves production; hosted fixtures refuse it.
# For an isolated Preview backend, configure its separate project reference:
PREVIEW_SUPABASE_PROJECT_REF=""
# Optional hosted browser acceptance must target a separate disposable project:
HOSTED_TEST_PROJECT_REF=""
# Production only, private random value >=32 chars; Vercel sends Bearer auth for cron.
CRON_SECRET=""
# Vercel Production/isolated Preview: full public PEM CA from Supabase →
# Database → Settings → SSL Configuration → Download certificate.
# Use literal \n between lines in dotenv, or paste the multiline PEM in Vercel.
SUPABASE_DB_CA_CERT=""
