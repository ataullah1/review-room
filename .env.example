# Copy to .env. These local URLs target ONLY the dedicated db:local:start cluster.
# Runtime may use a Supabase pooled URL later; CLI migrations use a direct/session URL.
DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
DIRECT_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
TEST_DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_test?schema=app"

# Hosted development Supabase setup is optional during local Step 1.
# Keep placeholders empty until configured. Never use production credentials here.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="review-room-private"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate a private random value (at least 32 characters) for HMAC IP hashing.
# Keep it stable across Vercel instances; do not prefix it with NEXT_PUBLIC_.
SIGNUP_RATE_LIMIT_SECRET=""
