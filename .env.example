# LOCAL DEVELOPMENT
# Copy this file to .env and configure your own values. Never commit .env.
# Start the dedicated local PostgreSQL cluster with pnpm db:local:start.
DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
DIRECT_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_dev?schema=app"
TEST_DATABASE_URL="postgresql://review_room_local@127.0.0.1:55432/review_room_test?schema=app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Use a separate development Supabase project for hosted local Auth/Storage.
# Supply that project's public URL, publishable key and private server key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="review-room-private"

# This is a private signing/HMAC secret, NOT a numeric rate-limit setting.
# If your .env already has it, reuse that SAME value in Vercel Production.
# Only when creating a new environment with no existing secret, generate one:
#   openssl rand -hex 32
# Keep it stable and separate from CRON_SECRET. Minimum length: 32 characters.
SIGNUP_RATE_LIMIT_SECRET=""

# Full Supabase public CA PEM. Required for deployed database connections;
# optional for local loopback PostgreSQL. Never paste a certificate file path.
# Supabase -> Database -> Settings -> SSL Configuration -> Download certificate.
# In .env, a quoted multiline PEM is supported. In Vercel, paste the entire PEM.
# BEGIN CERTIFICATE and END CERTIFICATE lines must be included.
SUPABASE_DB_CA_CERT=""

# Private Bearer secret for the scheduled cleanup endpoint. Local cron is optional.
# Generate independently with openssl rand -hex 32; minimum length: 32 characters.
CRON_SECRET=""

# VERCEL PRODUCTION — set these in the Dashboard, NOT in your local .env.
# Environment Variables -> scope: Production only.
# NEXT_PUBLIC_APP_URL=https://rreviewroom.vercel.app
# NEXT_PUBLIC_SUPABASE_URL=https://pwzwrknnzkdagfcjnqkr.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<that project's publishable key>
# SUPABASE_SECRET_KEY=<that project's private server key>
# SUPABASE_STORAGE_BUCKET=review-room-private
# DATABASE_URL=<transaction pooler URL from Supabase Connect, port 6543>
# SIGNUP_RATE_LIMIT_SECRET=<same existing stable secret from your .env>
# SUPABASE_DB_CA_CERT=<complete downloaded certificate PEM>
# CRON_SECRET=<independent private cron secret>
# DIRECT_URL: optional in Vercel; needed by operators for Prisma migrations.
# Use the session pooler (5432) or reachable direct URL, with encoded password.
# Keep TEST_DATABASE_URL local. Mark private secrets/DB URLs as Type: Secret;
# NEXT_PUBLIC_* variables are public configuration.
# Save variables BEFORE pushing the new code / redeploying Production.
# Complete settings and callback URLs: docs/RELEASE.md.

# PREVIEW / HOSTED TESTS — leave empty unless using a separate disposable project.
# Never copy production credentials into Preview. The live project above is blocked
# by the Preview backend guard and hosted browser-fixture runner.
PREVIEW_SUPABASE_PROJECT_REF=""
HOSTED_TEST_PROJECT_REF=""

# Optional public Google Search Console HTML-tag verification token.
# Set in Vercel Production, then rebuild; not required for Auth or the application.
GOOGLE_SITE_VERIFICATION=""

# Existing-backend public reviewer accounts need no extra Vercel demo variables.
# See DEMO_SETUP.md and the explicit demo:seed-existing command.
# To hide public cards on the existing backend, explicitly set:
# REVIEWER_DEMO_ENABLED="false"
